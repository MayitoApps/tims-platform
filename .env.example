# ==========================================
# TIMS Work OS - Variables de Entorno
# ==========================================

# 1. Base de Datos (Vercel Postgres / Supabase)
# Al conectar Supabase o Vercel Postgres desde el Marketplace de Vercel,
# estas variables se configuran automáticamente en tu proyecto.
DATABASE_URL="postgres://usuario:password@host:5432/tims_db"
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-de-supabase"

# 2. Autenticación Google OAuth (Google Cloud Console)
# Consigue estas credenciales en: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI en desarrollo: http://localhost:3000/api/auth/callback/google
# Authorized redirect URI en producción: https://tu-dominio.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# 3. NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secreto-aleatorio-aqui-con-openssl-rand-hex-32"
